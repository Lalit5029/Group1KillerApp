  "selectors": {
    "term": {
      "type": "select",
      "query": "[id^=\"CLASS_SRCH_WRK2_STRM$\"]",
      "submitAfterSet": false,
      "optional": true
    },
    "subject": {
      "type": "select",
      "query": "[id^=\"SSR_CLSRCH_WRK_SUBJECT_SRCH$\"]",
      "timeoutMs": 15000
    },
    "subjectCode": {
      "type": "input",
      "query": "[id^=\"SSR_CLSRCH_WRK_SUBJECT$\"]",
      "timeoutMs": 15000
    },
    "catalog": {
      "type": "input",
      "query": "[id^=\"SSR_CLSRCH_WRK_CATALOG_NBR$\"]",
      "timeoutMs": 15000
    },
    "searchButton": "#CLASS_SRCH_WRK2_SSR_PB_CLASS_SRCH",
    "clearButton": "#CLASS_SRCH_WRK2_SSR_PB_CLEAR",
    "resultsRow": "[id^=\"trSSR_CLSRCH_MTG1$\"][id$=\"_row1\"]",
    "noResults": ".no-results",
    "columns": {
      "subject": "",
      "catalog": "",
      "section": "td:nth-child(3)",
      "daysTimes": "td:nth-child(4)",
      "room": "td:nth-child(5)",
      "instructor": "td:nth-child(6)",
