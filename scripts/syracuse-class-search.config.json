  "chromeExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  "defaultTimeoutMs": 30000,
  "resultTimeoutMs": 15000,
  "waitAfterSearchMs": 1200,
  "preNavigationClicks": [
    {
      "query": "#ptpopupmsgbtn1",
      "waitAfterMs": 1000,
      "timeoutMs": 3000,
      "optional": true
    },
    {
      "query": "input[value*=\"Modify Search\"], a[title*=\"Modify Search\"]",
      "waitAfterMs": 1200,
      "timeoutMs": 4000,
      "optional": true
    }
